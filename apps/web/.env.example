# Only NEXT_PUBLIC_ values are visible in the browser. Never put secrets here.
# Server-only settings for the synthetic local/staging demo proxy.
APP_ENV=local
API_INTERNAL_URL=http://localhost:8000/v1
DEMO_API_TOKEN=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEFAULT_LOCALE=en   # en | sw
NEXT_PUBLIC_DEMO_BANNER=true    # shows the "synthetic data" notice
