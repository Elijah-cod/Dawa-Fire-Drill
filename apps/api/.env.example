# ---------- App ----------
APP_ENV=local                  # local | staging | production
LOG_LEVEL=INFO
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000
DEFAULT_COUNTRY=KE
SYNTHETIC_SEED=42              # makes generated data reproducible

# ---------- Database (Postgres) ----------
# Local docker-compose default; replace with the Supabase connection string in Phase 4
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dawa

# ---------- Supabase auth (Phase 2 auth, Phase 4 deploy) ----------
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=     # backend only, never in the web app

# ---------- Neo4j (funding trace graph) ----------
# Local docker-compose default; replace with AuraDB Free details in Phase 4
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------- LLM (bin-card extraction + explanations) ----------
LLM_PROVIDER=openai            # openai | gemini
OPENAI_API_KEY=
OPENAI_VISION_MODEL=           # set from current OpenAI docs, don't hardcode
OPENAI_TEXT_MODEL=             # cheaper model for explanations
GEMINI_API_KEY=                # optional free fallback
GEMINI_MODEL=
LLM_DAILY_CALL_CAP=200         # hard stop to protect credits
LLM_CACHE_BY_IMAGE_HASH=true

# ---------- Uploads & limits ----------
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
RATE_LIMIT_PER_MINUTE=60

# ---------- Scheduled jobs ----------
JOB_TRIGGER_TOKEN=             # long random string; GitHub Actions cron sends it
